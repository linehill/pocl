# This case should get vectorized by means of the LLVM loop vectorizer's
# reduction pattern detection.

# Remat and alloc sinking should take care of any needs for WI context.
CHECK-NOT: wi_context

# Let LLVM a lot of freedom to generate the reduction tree. Just make
# sure we do a final reduction within a vector:
CHECK: call i32 @llvm.vector.reduce.add.v8i32
